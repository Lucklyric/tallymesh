{
  "name": "tallymesh-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TallyMesh off-chain SDK: EIP-712 client/service signer, Merkle aggregator (Keccak + Poseidon), Groth16 prover bridge, viem-based settlement helper",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --testTimeout 180000 --no-file-parallelism",
    "test:eval": "vitest run test/eval --testTimeout 600000 --no-file-parallelism"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
